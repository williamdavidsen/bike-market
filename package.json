{
  "name": "bikemarket",
  "version": "0.1.0",
  "private": true,
  "description": "Bikemarket monorepo for a Norwegian bicycle e-commerce platform.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test tests/**/*.test.mjs",
    "test:stage1": "node --test Test_old/stage-1.structure.test.mjs",
    "test:stage2": "node --test Test_old/stage-2.backend.test.mjs && npm test -w @bikemarket/backend",
    "test:stage3": "node --test Test_old/stage-3.docker-postgres.test.mjs",
    "test:stage4": "node --test Test_old/stage-4.prisma.test.mjs",
    "test:stage5": "node --test Test_old/stage-5.backend-standards.test.mjs && npm test -w @bikemarket/backend",
    "test:stage6": "node --test Test_old/stage-6.auth.test.mjs && npm test -w @bikemarket/backend",
    "test:stage7": "node --test Test_old/stage-7.catalog.test.mjs && npm test -w @bikemarket/backend",
    "test:stage8": "node --test Test_old/stage-8.cart.test.mjs && npm test -w @bikemarket/backend",
    "test:stage9": "node --test Test_old/stage-9.checkout-order.test.mjs && npm test -w @bikemarket/backend",
    "test:stage10": "node --test Test_old/stage-10.payment-provider.test.mjs && npm test -w @bikemarket/backend",
    "test:stage11": "node --test Test_old/stage-11.frontend-foundation.test.mjs && npm run build -w @bikemarket/frontend",
    "test:stage12": "node --test Test_old/stage-12.frontend-catalog.test.mjs && npm run build -w @bikemarket/frontend",
    "test:stage13": "node --test Test_old/stage-13.frontend-product-filtering.test.mjs && npm run build -w @bikemarket/frontend",
    "test:stage14": "node --test Test_old/stage-14.frontend-product-detail.test.mjs && npm run build -w @bikemarket/frontend",
    "test:stage15": "node --test Test_old/stage-15.frontend-cart.test.mjs && npm run build -w @bikemarket/frontend",
    "test:stage16": "node --test Test_old/stage-16.frontend-checkout.test.mjs && npm run build -w @bikemarket/frontend",
    "test:stage17": "node --test Test_old/stage-17.frontend-admin.test.mjs && npm run build -w @bikemarket/frontend",
    "test:stage18": "node --test Test_old/stage-18.test-hardening.test.mjs && npm test -w @bikemarket/backend && npm run build -w @bikemarket/frontend",
    "test:stage19": "node --test Test_old/stage-19.norway-modules.test.mjs && npm run build -w @bikemarket/frontend && npm run typecheck -w @bikemarket/backend",
    "test:stage20": "node --test Test_old/stage-20.production-readiness.test.mjs && npm run build && npm run typecheck",
    "test:stage21": "node --test Test_old/stage-21.deployment-docs.test.mjs",
    "test:static": "node --test tests/static/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:api": "node --test tests/api/*.test.mjs && npm test -w @bikemarket/backend",
    "test:component": "node --test tests/component/*.test.mjs && npm run build -w @bikemarket/frontend",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:qa": "npm run test:static && npm run test:unit && npm run test:api && npm run test:component && npm run test:e2e && npm run test:security",
    "test:legacy": "node --test Test_old/*.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @bikemarket/backend",
    "db:seed": "npm run db:seed -w @bikemarket/backend",
    "deploy:check:server": "bash scripts/deployment/check-server-baseline.sh",
    "deploy:check:domain": "bash scripts/deployment/check-domain-ssl.sh",
    "deploy:check:pre-app": "bash scripts/deployment/check-pre-app-setup.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0"
  }
}

